{
  "name": "open-loop-starter",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "typecheck": "vue-tsc -b",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:sim": "SIM_PROBES=1 vitest run src/modules/mods/creep-vs-creep/sim/",
    "validate:archetypes": "vitest run scripts/validate-archetypes/ scripts/archetype-tooling/",
    "codegen:archetype-vars": "tsx scripts/archetype-tooling/bin/codegen.ts",
    "lint": "eslint src/",
    "format": "prettier --write \"src/**/*.{ts,vue,css,html}\"",
    "format:check": "prettier --check \"src/**/*.{ts,vue,css,html}\"",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,vue,css,html,json}": "prettier --write",
    "*.{ts,vue}": "eslint --fix"
  },
  "dependencies": {
    "break_eternity.js": "^2.1.3",
    "eternal_notations": "^1.1.1",
    "open-loop-engine": "link:../open-loop-engine",
    "reka-ui": "^2.9.0",
    "vue": "^3.5.30"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-vue": "^6.0.5",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.9.0",
    "eslint": "^10.1.0",
    "eslint-plugin-vue": "^10.8.0",
    "globals": "^17.4.0",
    "husky": "^9.1.7",
    "jsdom": "^24.1.1",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.1",
    "ts-morph": "^28.0.0",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.58.0",
    "unplugin-vue-components": "^32.0.0",
    "vite": "^8.0.1",
    "vitest": "^3.0.0",
    "vue-tsc": "^3.2.5"
  }
}
