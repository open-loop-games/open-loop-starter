{
  "name": "open-loop-starter",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "typecheck": "vue-tsc -b",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate:archetypes": "vitest run scripts/validate-archetypes/",
    "lint": "eslint src/",
    "format": "prettier --write \"src/**/*.{ts,vue,css,html}\"",
    "format:check": "prettier --check \"src/**/*.{ts,vue,css,html}\""
  },
  "dependencies": {
    "break_eternity.js": "^2.1.3",
    "eternal_notations": "^1.1.1",
    "open-loop-engine": "link:../open-loop-engine",
    "reka-ui": "^2.9.0",
    "vue": "^3.5.30"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-vue": "^6.0.5",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.9.0",
    "eslint": "^10.1.0",
    "eslint-plugin-vue": "^10.8.0",
    "globals": "^17.4.0",
    "jsdom": "^24.1.1",
    "prettier": "^3.8.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.58.0",
    "vite": "^8.0.1",
    "vitest": "^3.0.0",
    "vue-tsc": "^3.2.5"
  }
}
