{
  "name": "open-loop-starter",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "typecheck": "vue-tsc -b",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "eject": "node scripts/eject.mjs",
    "domain-map": "ol-domain-map src/showcase/archetypes/*/domain-map.config.mjs",
    "lint": "oxlint src/",
    "format": "oxfmt src",
    "format:check": "oxfmt --check src",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,vue,css,html,json}": "oxfmt --no-error-on-unmatched-pattern",
    "*.{ts,vue}": "oxlint --fix"
  },
  "dependencies": {
    "@atlaskit/pragmatic-drag-and-drop": "^1.8.1",
    "@atlaskit/pragmatic-drag-and-drop-hitbox": "^1.1.0",
    "@iconify-json/game-icons": "^1.2.4",
    "@iconify-json/mdi": "^1.2.3",
    "@iconify/vue": "^5.0.0",
    "@open-loop/engine": "^0.10.0",
    "break_eternity.js": "^2.1.3",
    "dompurify": "^3.4.1",
    "eternal_notations": "^1.1.1",
    "marked": "^18.0.2",
    "pixi.js": "^8.18.1",
    "reka-ui": "^2.9.0",
    "vue": "^3.5.43",
    "worker-timers": "^8.0.34"
  },
  "devDependencies": {
    "@types/node": "^24.13.6",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.0",
    "husky": "^9.1.7",
    "jsdom": "^30.1.1",
    "lint-staged": "^17.5.1",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.85.0",
    "ts-morph": "^28.0.0",
    "tsx": "^4.21.0",
    "typescript": "~6.0.3",
    "unplugin-vue-components": "^32.0.0",
    "vite": "^8.3.0",
    "vite-node": "^6.0.0",
    "vitest": "^5.0.1",
    "vue-tsc": "^3.3.11"
  },
  "packageManager": "pnpm@12.6.0"
}
